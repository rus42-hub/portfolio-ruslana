server {
    listen 80;
    listen [::]:80;
    server_name portfolio.ruslanabudniak.fr;

    root /var/www/portfolio/site/current;
    index index.html;

    location / {
        try_files $uri $uri/ $uri.html =404;
    }

    location /_astro/ {
        try_files $uri =404;
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    error_page 404 /404.html;
    location = /404.html {
        internal;
    }
}
