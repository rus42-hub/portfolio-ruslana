[Unit]
Description=Portfolio PocketBase
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=etudiant
Group=etudiant
WorkingDirectory=/var/www/portfolio/pocketbase
ExecStart=/var/www/portfolio/pocketbase/pocketbase serve --http=127.0.0.1:8092
Restart=always
RestartSec=5
LimitNOFILE=4096

[Install]
WantedBy=multi-user.target
