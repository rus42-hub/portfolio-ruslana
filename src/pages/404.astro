---
import BaseLayout from '../layouts/BaseLayout.astro';
import PaperButton from '../components/PaperButton.astro';
---
<BaseLayout lang="en" page="home" title="Page not found — Rus B.Lana" description="This page could not be found." notFound>
  <main class="paper-stage error-stage">
    <section class="error-paper" aria-labelledby="error-heading">
      <p class="outline-text font-display text-[clamp(5rem,20vw,14rem)] leading-none" aria-hidden="true">404</p>
      <h1 id="error-heading" class="mt-3 font-display text-[clamp(2rem,6vw,4.5rem)] leading-tight">Page not found</h1>
      <p class="mt-4 text-sm md:text-base">This page may have moved or the link may be out of date.</p>
      <PaperButton href="/">← Back to home</PaperButton>
    </section>
  </main>
</BaseLayout>

<style>
  .error-stage { display: grid; min-height: 100svh; place-items: center; padding: 2rem 5vw; }
  .error-paper {
    width: min(100%, 50rem);
    padding: clamp(2rem, 8vw, 6rem) clamp(1rem, 7vw, 5rem);
    background: var(--color-paper);
    color: var(--color-brown);
    text-align: center;
    mask: url('/shapes/project-paper.svg') center / 100% 100% no-repeat;
  }
</style>
