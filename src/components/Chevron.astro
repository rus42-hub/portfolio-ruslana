---
const { direction = 'up' } = Astro.props as { direction?: 'up' | 'left' | 'right' };
const rotation = { up: 0, left: -90, right: 90 }[direction];
---
<svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M5 12L10 7L15 12" transform={`rotate(${rotation} 10 10)`} stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" /></svg>
