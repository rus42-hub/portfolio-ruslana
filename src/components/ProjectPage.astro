---
import Chevron from './Chevron.astro';
import { field, fileURL, mediaURL, projectURL, accent, type FullProject } from '../lib/projects';
import { projectsCopy } from '../data/projects-copy';
import { url, type Language } from '../i18n';
import ProjectGallery from './ProjectGallery.astro';
import ModelFrame from '../lab-3d/ModelFrame.astro';
import { labModels } from '../lab-3d/models';
import ProjectStageContent from './ProjectStageContent.astro';
interface Props { project: FullProject; projects: FullProject[]; lang: Language; }
const { project, projects, lang } = Astro.props;
const t = projectsCopy[lang];
const model = project.categoryRecord.slug === '3d' ? labModels.find(item => item.slug === project.slug) : undefined;
const preview = project.media[0];
const index = projects.findIndex(item => item.id === project.id);
const characteristics = ['context', 'role', 'tools', 'technique', 'format'] as const;
const materialsLabel = { fr: 'Matériaux', en: 'Materials', ru: 'Материалы' }[lang];
---
<article class="project-page px-[7%] pb-16 pt-8" style={`--project-accent: ${accent(project)}`}>
  <h1 class="project-page-heading font-display font-bold leading-tight"><span>{field(project, 'title', lang)}</span>{field(project, 'title_outline', lang) && <span class:list={['outline-text', { 'block': field(project, 'title_join', lang) === 'new_line' }]}>{!['none', 'new_line'].includes(field(project, 'title_join', lang)) ? ' ' : ''}{field(project, 'title_outline', lang)}</span>}</h1>
  <div class="mt-7 flex flex-wrap items-center gap-5 text-sm"><span class="project-category-badge rounded-full px-4 py-2 text-[10px] font-semibold uppercase tracking-widest">{field(project.categoryRecord, 'name', lang)}</span><p class="opacity-65">{t[project.work_type as 'personal' | 'university' | 'professional']} · {project.completed_year}</p></div>
  <div class="project-overview mt-12 grid items-start gap-10 md:mt-20 md:grid-cols-2 md:gap-14">{model ? <ModelFrame model={preview?.type === 'image' ? { ...model, poster: mediaURL(preview) } : model} mode="gallery" class="lab-frame-gallery" fullscreenLabel={{ fr: 'Plein écran', en: 'Fullscreen', ru: 'Полный экран' }[lang]} playLabel={{ fr: 'Mettre en pause ou relancer la rotation', en: 'Pause or resume rotation', ru: 'Приостановить или возобновить вращение' }[lang]} /> : <ProjectGallery project={project} lang={lang} />}<div><div class="whitespace-pre-line text-sm leading-[1.8] md:text-base">{field(project, 'description', lang)}</div><dl class="mt-9 grid grid-cols-2 gap-3">{characteristics.filter(name => field(project, name, lang)).map(name => <div class="rounded-card border border-brown/10 bg-card p-4"><dt class="project-accent text-[10px] uppercase tracking-widest">{name === "tools" && project.slug === "brutalisme" ? materialsLabel : t[name]}</dt><dd class="mt-2 text-sm leading-relaxed">{field(project, name, lang)}</dd></div>)}<div class="rounded-card border border-brown/10 bg-card p-4"><dt class="project-accent text-[10px] uppercase tracking-widest">{t.year}</dt><dd class="mt-2 text-sm">{project.completed_year}</dd></div></dl></div></div>
  {project.sections.length > 0 && <ol class="mt-16 md:mt-24">{project.sections.map((section, position) => <li class="project-detail-stage grid gap-5 border-t border-brown/30 py-9 md:grid-cols-[120px_1fr] md:gap-10"><span class="project-accent font-display text-5xl md:text-7xl" aria-hidden="true">{String(position + 1).padStart(2, '0')}</span><div><h2 class="project-accent text-sm font-bold uppercase tracking-widest">{field(section, 'title', lang)}</h2><ProjectStageContent section={section} lang={lang} />{section.detail_image && <picture class="mt-7 block">{section.detail_image_mobile && <source media="(max-width: 767px)" srcset={fileURL(section, 'project_sections', section.detail_image_mobile)} />}<img src={fileURL(section, 'project_sections', section.detail_image)} alt={field(section, 'detail_alt', lang)} loading="lazy" class="max-h-[600px] max-w-full object-contain" /></picture>}{field(section, 'note', lang) && <p class="mt-6 whitespace-pre-line text-xs leading-relaxed opacity-65 md:text-sm">{field(section, 'note', lang)}</p>}{section.button_url && <a href={section.button_url} target="_blank" rel="noopener noreferrer" class="project-detail-link mt-6 inline-flex rounded-full border px-5 py-3 text-xs uppercase tracking-wider">{field(section, 'button_label', lang)} ↗</a>}</div></li>)}</ol>}
  <nav class="mt-16 grid grid-cols-2 gap-6 border-t border-brown/30 pt-9 text-xs uppercase md:mt-24 md:grid-cols-3" aria-label={t.viewAll}>{projects[index - 1] ? <a href={projectURL(projects[index - 1], lang)} class="inline-flex items-center gap-2 [&>svg]:shrink-0"><Chevron direction="left" />{t.previous}</a> : <span aria-disabled="true" class="inline-flex items-center gap-2 opacity-40 [&>svg]:shrink-0"><Chevron direction="left" />{t.previous}</span>}<a href={url(lang, 'projects')} class="col-span-2 row-start-2 text-center md:col-span-1 md:row-start-auto">{t.viewAll}</a>{projects[index + 1] && <a href={projectURL(projects[index + 1], lang)} class="inline-flex items-center justify-end gap-2 text-right [&>svg]:shrink-0">{t.next}<Chevron direction="right" /></a>}</nav>
</article>
