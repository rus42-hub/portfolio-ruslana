---
import { aboutCopy, tools, interests } from '../data/about';
import { copy, url, type Language } from '../i18n';
import Portrait from './Portrait.astro';
import PaperButton from './PaperButton.astro';
interface Props { lang: Language; }
const { lang } = Astro.props;
const t = aboutCopy[lang];
---
<article class="about-page">
  <section class="about-intro px-[7%] pb-14 pt-8 md:pb-16">
    <div>
      <h1 class="about-page-title font-display font-bold uppercase"><span>{t.headline[0]}</span><span class="outline-text">{t.headline[1]}</span><span>{t.headline[2]}</span></h1>
      <div class="mt-10 max-w-[520px] md:mt-16">
        <p class="text-sm font-bold uppercase tracking-[2px] md:text-base">Ruslana Budniak</p>
        <p class="mt-3 text-sm font-bold uppercase leading-relaxed tracking-[1.5px] md:text-base">{copy[lang].designer}</p>
        <p class="mt-5 text-sm leading-[1.7] md:text-base">{t.introduction}</p>
        <div class="mt-8 flex flex-col items-center gap-6 md:flex-row md:items-center">
          <a href={url(lang, 'projects')} class="pill-button inline-flex min-h-[45px] items-center justify-center px-8 text-xs font-bold uppercase tracking-[1.5px]">{t.projects} →</a>
          <a href="/CV.pdf" download class="text-center text-xs font-semibold uppercase tracking-[1.5px] underline underline-offset-4">{t.cv} ↓</a>
        </div>
      </div>
    </div>
    <Portrait lang={lang} variant="about" />
  </section>
  <section class="about-block px-[7%] py-14 md:py-16" aria-labelledby="skills-title">
    <h2 id="skills-title" class="about-section-title font-display font-bold uppercase"><span class="outline-text">{t.skillsTitle[0]}</span> {t.skillsTitle[1]}</h2>
    <ol class="skills-grid mt-12 md:mt-16">{t.skills.map((skill, index) => <li class:list={['skill', { 'skill-wide': index === 4 }]}>
      <div class="skill-heading"><span class="skill-number font-display text-accent" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span><div class="min-w-0"><div class="skill-rule" aria-hidden="true"><span></span><i>•••</i></div><h3 class="skill-title font-display font-bold uppercase">{skill.title}</h3><p class="mt-2 text-xs font-semibold leading-relaxed md:text-sm">{skill.subtitle}</p></div></div>
      <ul class="skill-description mt-7 text-sm leading-[1.8] md:text-base">{skill.lines.map(line => <li>{line}</li>)}</ul>
    </li>)}</ol>
  </section>
  <section class="about-block px-[7%] py-12 md:py-14" aria-labelledby="tools-title">
    <div class="flex flex-wrap items-center gap-x-9 gap-y-5"><h2 id="tools-title" class="about-section-title font-display font-bold uppercase"><span class="outline-text">{t.toolsTitle[0]}</span> {t.toolsTitle[1]}</h2><p class="section-label text-xs font-semibold uppercase tracking-[2px] md:text-lg">{t.software}</p></div>
    <div class="tools-grid mt-10 md:mt-14">{tools.map(group => <section class={`tool-card tool-card-${group.category} rounded-card bg-card p-6 md:p-8`} aria-label={t.categories[group.category]}>
      <h3 class="text-xs font-bold uppercase tracking-[1.5px] md:text-sm">{t.categories[group.category]}</h3>
      <ul class="mt-6 flex items-start justify-between gap-2 md:mt-10">{group.items.map(([name, icon]) => <li class="min-w-0 flex-1 text-center"><div class="tool-icon"><img src={`/images/tools/${icon}.png`} alt="" class:list={{ 'tool-figma': icon === 'figma' }} /></div><span class="mt-2 block text-[10px] leading-relaxed md:text-[11px]">{name}</span></li>)}</ul>
    </section>)}</div>
  </section>
  <section class="about-block px-[7%] pb-16 pt-14 md:pt-16" aria-labelledby="journey-title">
    <h2 id="journey-title" class="about-section-title font-display font-bold uppercase">{t.journeyTitle[0]} <span class="outline-text">{t.journeyTitle[1]}</span></h2>
    <div class="journey-grid mt-8 grid gap-12 md:grid-cols-2 md:gap-16">
      <div><h3 class="section-label text-xs font-semibold uppercase tracking-[2px] md:text-lg">{t.education}</h3><p class="mt-8 max-w-[500px] text-lg font-bold md:text-xl">{t.degree}</p><p class="mt-6 max-w-[500px] text-sm leading-[1.7] md:text-base">{t.course}<br />{t.courseDescription}</p></div>
      <div class="journey-interests"><h3 class="text-xs font-semibold uppercase tracking-[1.5px] md:text-lg">{t.inspiration}</h3><ul class="mt-7 grid grid-cols-4 gap-3 md:gap-7">{interests.map(interest => <li class="text-center"><div class="interest-icon flex aspect-square items-center justify-center rounded-card bg-card"><img src={`/shapes/interests/${interest}.svg`} alt="" /></div><p class="mt-4 text-[10px] font-semibold uppercase tracking-wider md:text-xs">{t.interests[interest]}</p></li>)}</ul></div>
    </div>
    <div class="mt-16 hidden justify-center md:flex"><PaperButton href={url(lang, 'projects')}>{copy[lang].discover}<span aria-hidden="true">→</span></PaperButton></div>
  </section>
</article>
