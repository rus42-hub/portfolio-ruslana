---
const socials = [{ name: 'Instagram', icon: 'instagram', href: 'https://www.instagram.com/rusiabudniak/' }, { name: 'LinkedIn', icon: 'linkedin', href: 'https://www.linkedin.com/in/ruslana-budniak-53476633a' }, { name: 'Behance', icon: 'behance', href: 'https://www.behance.net/lanabudnak' }];
---
<nav aria-label="Social media" class="flex flex-wrap items-center gap-6">{socials.map(social => <a href={social.href} class="social-link inline-flex items-center gap-3 text-sm md:text-[17px]" target="_blank" rel="noopener noreferrer"><img src={`/images/${social.icon}.png`} alt="" width="30" height="30" /><span>{social.name}</span></a>)}</nav>
