---
import type { LabModel } from './models';
import './lab.css';
interface Props { model: LabModel; mode: 'home' | 'scroll' | 'pin' | 'drag' | 'path' | 'gallery'; class?: string; fit?: number; playLabel?: string; fullscreenLabel?: string; }
const { model, mode, class: className, fit, playLabel = 'Pause / lecture', fullscreenLabel } = Astro.props;
---
<div class:list={['lab-frame', className]} data-lab-model={JSON.stringify(model)} data-lab-mode={mode} data-lab-fit={fit} style={`--lab-background: ${model.background}`}>
  {model.backdrop && <img class="lab-backdrop" src={model.backdrop} alt="" decoding="async" />}
  <div class="lab-canvas-slot" data-lab-canvas></div>
  <img class="lab-poster" src={model.poster} alt={`${model.title} — rendu Blender`} />
  <span class="lab-progress" data-lab-progress aria-hidden="true"></span>
  {mode !== 'home' && <div class="lab-loading" aria-hidden="true"><span></span><span></span><span></span></div>}
  {mode === 'gallery' && <div class="lab-controls"><span class="lab-badge">360°</span><button type="button" data-lab-play aria-label={playLabel}>❚❚</button></div>}
  {fullscreenLabel && <button type="button" class="lab-fullscreen" data-lab-fullscreen aria-label={fullscreenLabel} title={fullscreenLabel} aria-pressed="false" hidden><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 4H4v5m11-5h5v5M4 15v5h5m11-5v5h-5" /></svg></button>}
</div>
<script>
  import './lab-page';
</script>
